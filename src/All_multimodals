def prepare_string_col(s):
    return s.astype(str).str.strip()

def prepare_sequence_col(s):
    return s.astype(str).str.strip().str.upper()

def merge_transpolymer_embeddings(base_df, tp_df):
    tp2_cols = [c for c in tp_df.columns if c.startswith("transpolymer2_")]
    if len(tp2_cols) == 0:
        raise ValueError("No Transpolymer2 columns found in TRANSPOLYMER_INPUT_CSV. Expected columns starting with 'transpolymer2_'.")

    # Standardize possible merge columns
    for df_ in [base_df, tp_df]:
        if SEQUENCE_COL in df_.columns:
            df_[SEQUENCE_COL] = prepare_sequence_col(df_[SEQUENCE_COL])
        if POLYMER_SMILES_COL in df_.columns:
            df_[POLYMER_SMILES_COL] = prepare_string_col(df_[POLYMER_SMILES_COL])
        if TARGET_COL in df_.columns:
            df_[TARGET_COL] = pd.to_numeric(df_[TARGET_COL], errors="coerce")
        for c in ["polymer_family", "polymer_name"]:
            if c in df_.columns:
                df_[c] = prepare_string_col(df_[c])

    # Prefer stronger merge keys when available
    candidate_keys = ["sequence", "repeat_unit_smiles", "degradation_label", "polymer_family", "polymer_name"]
    merge_keys = [c for c in candidate_keys if c in base_df.columns and c in tp_df.columns]

    if len(merge_keys) == 0:
        raise ValueError(
            "Could not find shared merge keys between the base file and the Transpolymer file. "
            "At minimum, they should share 'sequence', preferably with repeat_unit_smiles and/or other metadata."
        )

    print("\nMerging Transpolymer2 embeddings using keys:", merge_keys)

    tp_keep = merge_keys + tp2_cols
    tp_small = tp_df[tp_keep].copy()

    # Drop exact duplicates in transpolymer file for the chosen keys
    tp_small = tp_small.drop_duplicates(subset=merge_keys).copy()

    merged = base_df.merge(tp_small, on=merge_keys, how="left", validate="m:1")

    missing_rows = merged[tp2_cols].isna().all(axis=1).sum()
    if missing_rows > 0:
        raise ValueError(
            f"{missing_rows} rows in the base input did not receive Transpolymer2 embeddings after merge. "
            f"Check whether the two files use matching values for the merge keys: {merge_keys}"
        )

    print("Transpolymer2 columns found:", len(tp2_cols))
    print("Rows successfully matched to Transpolymer2 embeddings:", len(merged) - missing_rows)

    return merged, tp2_cols

