    "amide_flag",
    "aromatic_flag",
    "ester_flag",
    "ether_flag",
    "hydrocarbon_flag",
    "urethane_flag"
]:
    if c in df.columns:
        metadata_cols.append(c)

final_df = pd.concat([
    df[metadata_cols].reset_index(drop=True),
    handcrafted_df.reset_index(drop=True),
    df[seq_embed_cols].reset_index(drop=True),
    poly_desc_df.reset_index(drop=True),
    fp_df.reset_index(drop=True),
    gat_df.reset_index(drop=True),
    df[tp2_cols].reset_index(drop=True)
], axis=1)

# =========================================================
# SAVE
