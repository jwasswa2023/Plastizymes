# =========================================================
# UQ 4 x 6 BOXPLOT GRID
# Unimodal vs Polymer-Augmented Models
# Includes PolyBERT results
# Keeps original style:
#   - Auto y-axis scaling
#   - Closed plot frames
#   - No forced y-limits
# =========================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import re

# =========================================================
# USER SETTINGS
# =========================================================
FILE_PATH = "/content/UQ_Unimodal.xlsx"
UNIMODAL_SHEET = "Sheet1"
POLYMER_SHEET = "Sheet2"

OUTPUT_FIG = "/content/uq_boxplot_compact_with_polybert.png"

METRICS = [
    "MeanPredictiveEntropy",
    "ECE",
    "MCE",
    "BrierScore",
    "NLL",
    "Corr_error_entropy",
]

SPLIT_ORDER = ["Random", "MMseqs2", "Leave-one-out"]

FIGSIZE = (18, 18)
BOX_WIDTH = 0.32
BOX_STEP = 0.52
POINT_JITTER = 0.06

SIZE_SUPTITLE = 18
SIZE_COL_TITLE = 16
SIZE_YLABEL = 16
SIZE_XTICKS = 16
SIZE_YTICKS = 16
ROTATION = 50
POINT_SIZE = 16

# =========================================================
# HELPERS
# =========================================================
def parse_mean_sd(val):
    if pd.isna(val):
        return np.nan, np.nan

    if isinstance(val, (int, float, np.integer, np.floating)):
        return float(val), 0.0

    s = str(val).strip()

    if "±" in s:
        a, b = s.split("±", 1)
        return float(a.strip()), float(b.strip())

    nums = re.findall(r"[-+]?\d*\.?\d+(?:[eE][-+]?\d+)?", s)

    if len(nums) >= 2:
        return float(nums[0]), float(nums[1])
    elif len(nums) == 1:
        return float(nums[0]), 0.0
    else:
        return np.nan, np.nan


def canonical_split(x):
    s = str(x).strip()

    if s in [
        "Leave-out-one",
        "Leave one out",
        "Leave-one-out",
        "Leave-one-polymer",
        "Leave-out-one polymer",
        "Leave-out-one polymer family",
        "LOPO",
    ]:
        return "Leave-one-out"

    if s.startswith("MMseqs"):
        return "MMseqs2"

    if s.lower() == "random":
        return "Random"

    return s


def canonical_modality(x):
    s = str(x).strip()

    replacements = {
        # Prot2Vec family
        "Prot2vec Transpolymer": "Prot2vec + Transpolymer",
        "Prot2vec+Transpolymer": "Prot2vec + Transpolymer",
        "Prot2Vec + PolyBERT": "Prot2vec + PolyBERT",

        # ESM2 family
        "ESM2+ Transpolymer": "ESM2 + Transpolymer",
        "ESM2 + one-hot-polymer": "ESM2 + one-hot polymer label",
        "ESM2 + Polymer Chemistry Descrptors": "ESM2 + polymer chemistry descriptors",

        # ProtBERT family
        "ProtBERT + one-hot-polymer": "ProtBERT + one-hot polymer label",
        "ProtBERT + Polymer Chemsitry Descriptors": "ProtBERT + polymer chemistry descriptors",
        "ProtBERT +PolyBERT": "ProtBERT + PolyBERT",

        # Sequence descriptor spacing
        "Sequence descriptors +Prot2Vec": "Sequence Descriptors + Prot2Vec",
    }

    return replacements.get(s, s)


def get_group_values(df, modality, metric):
    sub = df[df["Modality"] == modality].copy()
    sub = sub[sub["Data Split"].isin(SPLIT_ORDER)].copy()

    sub["Data Split"] = pd.Categorical(
        sub["Data Split"],
        categories=SPLIT_ORDER,
        ordered=True,
    )

    sub = sub.sort_values("Data Split")

    return sub[f"{metric}_mean"].dropna().tolist()

# =========================================================
# LOAD DATA
# =========================================================
df_uni = pd.read_excel(FILE_PATH, sheet_name=UNIMODAL_SHEET)
df_poly = pd.read_excel(FILE_PATH, sheet_name=POLYMER_SHEET)

for df in [df_uni, df_poly]:
    df.columns = [str(c).strip() for c in df.columns]
    df["Modality"] = df["Modality"].astype(str).str.strip().apply(canonical_modality)
    df["Data Split"] = df["Data Split"].astype(str).str.strip().apply(canonical_split)

# =========================================================
# PARSE METRICS
# =========================================================
for metric in METRICS:
    for df in [df_uni, df_poly]:
        parsed = df[metric].apply(parse_mean_sd)
        df[f"{metric}_mean"] = parsed.apply(lambda x: x[0])

# =========================================================
# FAMILIES
# =========================================================
families = [
    (
        "Prot2Vec",
        "Prot2Vec",
        [
            "Prot2vec + one-hot polymer label",
            "Prot2vec + polymer chemistry descriptors",
            "Prot2vec + Transpolymer",
            "Prot2vec + PolyBERT",
        ],
        ["Base", "+1Hot", "+PolyChem", "+TP", "+pBERT"],
    ),
    (
        "SeqDesc",
        "Sequence Descriptors",
        [
            "Sequence descriptors + one-hot polymer label",
            "Sequence descriptors + polymer chemistry descriptors",
            "Sequence descriptors + Transpolymer",
            "Sequence descriptors + PolyBERT",
        ],
        ["Base", "+1Hot", "+PolyChem", "+TP", "+pBERT"],
    ),
    (
        "ESM2",
        "ESM-2",
        [
            "ESM2 + one-hot polymer label",
            "ESM2 + polymer chemistry descriptors",
            "ESM2 + Transpolymer",
            "ESM2 + PolyBERT",
        ],
        ["Base", "+1Hot", "+PolyChem", "+TP", "+pBERT"],
    ),
    (
        "ProtBERT",
        "ProtBERT",
        [
            "ProtBERT + one-hot polymer label",
            "ProtBERT + polymer chemistry descriptors",
            "ProtBERT + Transpolymer",
            "ProtBERT + PolyBERT",
        ],
        ["Base", "+1Hot", "+PolyChem", "+TP", "+pBERT"],
    ),
]

box_colors = [
    "#4C78A8",  # Base
    "#F58518",  # 1Hot
    "#54A24B",  # PolyChem
    "#E45756",  # TP
    "#7570B3",  # pBERT
]

# =========================================================
# FIGURE
# =========================================================
fig, axes = plt.subplots(4, 6, figsize=FIGSIZE)

for r, (row_name, base_mod, poly_mods, xlabels) in enumerate(families):

    for c, metric in enumerate(METRICS):

        ax = axes[r, c]

        base_vals = get_group_values(df_uni, base_mod, metric)

        groups = [base_vals]

        for m in poly_mods:
            groups.append(get_group_values(df_poly, m, metric))

        positions = np.arange(len(groups)) * BOX_STEP

        bp = ax.boxplot(
            groups,
            positions=positions,
            widths=BOX_WIDTH,
            patch_artist=True,
            showmeans=True,
            meanline=False,
        )

        for mean in bp["means"]:
            mean.set(
                marker="D",
                markerfacecolor="black",
                markeredgecolor="black",
                markersize=5,
            )

        for i, patch in enumerate(bp["boxes"]):
            patch.set_facecolor(box_colors[i])
            patch.set_edgecolor("black")
            patch.set_linewidth(1.0)

        for median in bp["medians"]:
            median.set_color("black")
            median.set_linewidth(1.5)

        for whisker in bp["whiskers"]:
            whisker.set_color("black")
            whisker.set_linewidth(1.0)

        for cap in bp["caps"]:
            cap.set_color("black")
            cap.set_linewidth(1.0)

        for flier in bp["fliers"]:
            flier.set(
                marker="o",
                markersize=4,
                markerfacecolor="gray",
                markeredgecolor="gray",
                alpha=0.6,
            )

        rng = np.random.default_rng(42 + r * 10 + c)

        for i, vals in enumerate(groups):
            if len(vals) == 0:
                print(
                    f"Warning: no data for {row_name} | {xlabels[i]} | {metric}"
                )
                continue

            if len(vals) != 3:
                print(
                    f"Warning: {row_name} | {metric} | {xlabels[i]} "
                    f"has {len(vals)} values instead of 3"
                )

            jitter = rng.uniform(
                -POINT_JITTER,
                POINT_JITTER,
                size=len(vals),
            )

            ax.scatter(
                np.full(len(vals), positions[i]) + jitter,
                vals,
                color="black",
                s=POINT_SIZE,
                alpha=0.6,
                zorder=3,
            )

        if r == 0:
            ax.set_title(
                metric,
                fontsize=SIZE_COL_TITLE,
                fontweight="bold",
            )

        if c == 0:
            ax.set_ylabel(
                row_name,
                fontsize=SIZE_YLABEL,
                fontweight="bold",
            )

        ax.set_xticks(positions)
        ax.set_xticklabels(
            xlabels,
            rotation=ROTATION,
            fontsize=SIZE_XTICKS,
            ha="right",
        )

        ax.tick_params(axis="y", labelsize=SIZE_YTICKS)
        ax.grid(axis="y", linestyle=":", alpha=0.3)
        ax.set_axisbelow(True)

        # Keep closed frames
        for spine in ax.spines.values():
            spine.set_visible(True)

        ax.set_xlim(
            positions[0] - BOX_STEP * 0.55,
            positions[-1] + BOX_STEP * 0.55,
        )

        if metric == "Corr_error_entropy":
            ax.axhline(
                0,
                linestyle=":",
                color="black",
                alpha=0.8,
            )

# =========================================================
# SUPTITLE + SAVE
# =========================================================
fig.suptitle(
    "Unimodal vs Polymer-Augmented Models Including pBERT",
    fontsize=SIZE_SUPTITLE,
    fontweight="bold",
)

plt.tight_layout(rect=[0, 0, 1, 0.96])
plt.savefig(OUTPUT_FIG, dpi=600, bbox_inches="tight")
plt.show()

print(f"Figure saved to: {OUTPUT_FIG}")
