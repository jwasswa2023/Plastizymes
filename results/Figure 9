# 9. DRAW PANEL
# ============================================================
def draw_heatmap_panel(
    axis,
    data,
    metrics,
    show_polymer_labels=False,
):
    """
    metrics is a list of tuples:

        (
            printed_change_column,
            absolute_color_column,
            x_axis_label,
            higher_absolute_is_better,
        )
    """

    n_rows = len(data)
    n_columns = len(metrics)

    change_matrix = np.zeros(
        (
            n_rows,
            n_columns,
        ),
        dtype=float,
    )

    color_matrix = np.zeros_like(
        change_matrix
    )

    for column_index, (
        change_column,
        absolute_column,
        _,
        higher_absolute_is_better,
    ) in enumerate(metrics):

        changes = as_float_array(
            data[
                change_column
            ]
        )

        absolute_values = as_float_array(
            data[
                absolute_column
            ]
        )

        change_matrix[
            :,
            column_index
        ] = changes

        color_matrix[
            :,
            column_index
        ] = min_max_norm(
            absolute_values,
            higher_is_better=(
                higher_absolute_is_better
            ),
        )

    axis.imshow(
        color_matrix,
        cmap=absolute_cmap,
        vmin=0.0,
        vmax=1.0,
        aspect="auto",
        interpolation="nearest",
        origin="upper",
    )

    # Printed numbers are relative percentage changes only.
    for row_index in range(
        n_rows
    ):
        for column_index in range(
            n_columns
        ):
            change_value = change_matrix[
                row_index,
                column_index
            ]

            label = (
                f"{change_value:+.1f}%"
                if np.isfinite(change_value)
                else "NA"
            )

            rgba = absolute_cmap(
                color_matrix[
                    row_index,
                    column_index
                ]
            )

            axis.text(
                column_index,
                row_index,
                label,
                ha="center",
                va="center",
                fontsize=9.1,
                fontweight="bold",
                color=readable_text_color(
                    rgba
                ),
            )

    axis.set_xticks(
        np.arange(
            n_columns
        )
    )

    axis.set_xticklabels(
        [
            label
            for (
                _,
                _,
                label,
                _,
            ) in metrics
        ],
        fontsize=9.8,
        linespacing=1.0,
    )

    axis.xaxis.tick_top()

    axis.tick_params(
        axis="x",
        length=0,
        pad=6,
    )

    axis.set_yticks(
        np.arange(
            n_rows
        )
    )

    if show_polymer_labels:
        axis.set_yticklabels(
            data[
                "polymer_short"
            ],
            fontsize=9.0,
        )
    else:
        axis.set_yticklabels([])

    axis.tick_params(
        axis="y",
        length=0,
        pad=5,
    )

    axis.set_xticks(
        np.arange(
            -0.5,
            n_columns,
            1.0,
        ),
        minor=True,
    )

    axis.set_yticks(
        np.arange(
            -0.5,
            n_rows,
            1.0,
        ),
        minor=True,
    )

    axis.grid(
        which="minor",
        color="white",
        linewidth=0.8,
    )

    axis.tick_params(
        which="minor",
        bottom=False,
        left=False,
    )

    for boundary in [
        4.5,
        9.5,
        14.5,
        19.5,
    ]:
        axis.axhline(
            boundary,
            color="black",
            linewidth=1.5,
        )

    axis.set_xlim(
        -0.5,
        n_columns - 0.5,
    )

    axis.set_ylim(
        n_rows - 0.5,
        -0.5,
    )


