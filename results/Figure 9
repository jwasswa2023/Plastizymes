def as_float_array(values):
    return np.asarray(
        pd.to_numeric(
            values,
            errors="coerce",
        ),
        dtype=float,
    )


def min_max_norm(
    values,
    higher_is_better,
):
    """
    Normalize one metric across all 25 combinations.

    Returns values in [0, 1], where:
        0 = less favorable
        1 = more favorable
    """
    array = as_float_array(values)

    finite = array[
        np.isfinite(array)
    ]

    if finite.size == 0:
        return np.full_like(
            array,
            0.5,
            dtype=float,
        )

    minimum = float(
        np.min(finite)
    )

    maximum = float(
        np.max(finite)
    )

    if np.isclose(
        minimum,
        maximum,
    ):
        normalized = np.full_like(
            array,
            0.5,
            dtype=float,
        )
    else:
        normalized = (
            array
            - minimum
        ) / (
            maximum
            - minimum
        )

    if not higher_is_better:
        normalized = (
            1.0
            - normalized
        )

    return normalized


def readable_text_color(rgba):
    red, green, blue, _ = rgba

    luminance = (
        0.299 * red
        + 0.587 * green
        + 0.114 * blue
    )

    return (
        "white"
        if luminance < 0.48
        else "black"
    )


