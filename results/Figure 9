def add_protein_group_labels(
    axis,
):
    rows_per_group = len(
        polymer_order
    )

    for group_index, protein_name in enumerate(
        protein_order
    ):
        start = (
            group_index
            * rows_per_group
        )

        end = (
            start
            + rows_per_group
            - 1
        )

        midpoint = (
            start
            + end
        ) / 2.0

        axis.text(
            -1.62,
            midpoint,
            protein_short[
                protein_name
            ],
            ha="center",
            va="center",
            rotation=90,
            fontsize=10.0,
            fontweight="bold",
            clip_on=False,
        )


