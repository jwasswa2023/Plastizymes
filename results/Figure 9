# ============================================================
# 5. RELATIVE CHANGE FUNCTIONS
# ============================================================
def relative_change_higher_better(
    new_value,
    baseline_value,
):
    if (
        pd.isna(new_value)
        or pd.isna(baseline_value)
        or np.isclose(baseline_value, 0.0)
    ):
        return np.nan

    return (
        100.0
        * (
            new_value
            - baseline_value
        )
        / abs(baseline_value)
    )


def relative_change_lower_better(
    new_value,
    baseline_value,
):
    if (
        pd.isna(new_value)
        or pd.isna(baseline_value)
        or np.isclose(baseline_value, 0.0)
    ):
        return np.nan

    return (
        100.0
        * (
            baseline_value
            - new_value
        )
        / abs(baseline_value)
    )


def relative_cost_change(
    new_value,
    baseline_value,
):
    if (
        pd.isna(new_value)
        or pd.isna(baseline_value)
        or np.isclose(baseline_value, 0.0)
    ):
        return np.nan

    return (
        100.0
        * (
            new_value
            - baseline_value
        )
        / abs(baseline_value)
    )


