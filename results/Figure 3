# =========================================================
# SEPARATE LightGBM AND XGBoost BAR PLOTS
# Clean publication style: fixed y-limits + hidden top/right spines
# =========================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import re

plt.rcParams.update(plt.rcParamsDefault)

# =========================================================
# USER SETTINGS
# =========================================================
FILE_PATH = "/content/Unimodal_plus_polymer.xlsx"
SHEET_NAME = 0

METRICS = ["AUROC", "AUPRC", "BA", "MCC"]
SPLIT_ORDER = ["Random", "MMseqs2", "Leave-one-out"]

MODEL_GROUPS = {
    "LightGBM": ["LightGBM"],
    "XGBoost": ["XGBoost"],
}

# =========================================================
# FONT SIZE SETTINGS
# =========================================================
SIZE_SUPTITLE = 30
SIZE_TITLE = 30
SIZE_YLABEL = 30
SIZE_XTICKS = 30
SIZE_YTICKS = 30
SIZE_SPLIT_LABEL = 30
SIZE_LEGEND = 30

# =========================================================
# PLOT SETTINGS
# =========================================================
BAR_WIDTH = 0.82
ROTATION = 45
ERROR_CAPSIZE = 3
SECTION_GAP = 3.0
LEGEND_NCOL = 5

YLIMS = {
    "AUROC": (0.0, 1.05),
    "AUPRC": (0.0, 1.05),
    "BA":    (0.0, 1.05),
    "MCC":   (-0.1, 1.05),
}

# =========================================================
# LOAD DATA
# =========================================================
df = pd.read_excel(FILE_PATH, sheet_name=SHEET_NAME)
df.columns = [str(c).strip() for c in df.columns]

required_cols = ["Modality", "Model", "Data Split"] + METRICS
missing_cols = [c for c in required_cols if c not in df.columns]
if missing_cols:
    raise ValueError(f"Missing required columns: {missing_cols}")

# =========================================================
# CLEAN SPLIT NAMES
# =========================================================
df["Data Split"] = df["Data Split"].astype(str).str.strip()

split_map = {
    "Random": "Random",
    "random": "Random",
    "MMseqs2": "MMseqs2",
    "mmseqs2": "MMseqs2",
    "MMseqs3": "MMseqs2",
    "MMseqs4": "MMseqs2",
    "Leave-one-out": "Leave-one-out",
    "Leave one out": "Leave-one-out",
    "Leave-one-polymer": "Leave-one-out",
    "Leave-out-one polymer": "Leave-one-out",
    "Leave-out-one polymer family": "Leave-one-out",
    "LOPO": "Leave-one-out",
}

df["Data Split"] = df["Data Split"].replace(split_map)
df = df[df["Data Split"].isin(SPLIT_ORDER)].copy()

if df.empty:
    raise ValueError("No rows remain after filtering for the desired split names.")

# =========================================================
# PARSE mean ± sd VALUES
# =========================================================
def parse_mean_sd(val):
    if pd.isna(val):
        return np.nan, np.nan

    if isinstance(val, (int, float, np.integer, np.floating)):
        return float(val), 0.0

    s = str(val).strip()

    if "±" in s:
        left, right = s.split("±", 1)
        return float(left.strip()), float(right.strip())

    nums = re.findall(r"[-+]?\d*\.?\d+(?:[eE][-+]?\d+)?", s)

    if len(nums) >= 2:
        return float(nums[0]), float(nums[1])
    elif len(nums) == 1:
        return float(nums[0]), 0.0
    else:
        return np.nan, np.nan

for metric in METRICS:
    parsed = df[metric].apply(parse_mean_sd)
    df[f"{metric}_mean"] = parsed.apply(lambda x: x[0])
    df[f"{metric}_sd"] = parsed.apply(lambda x: x[1])

# =========================================================
# CLEAN LABEL FIELDS
# =========================================================
df["Modality"] = df["Modality"].astype(str).str.strip()
df["Model"] = df["Model"].astype(str).str.strip()

# =========================================================
# SHORTEN MODALITY NAMES
# =========================================================
short_names = {
    "Prot2vec + one-hot polymer label": "Prot2Vec+1HotPoly",
    "Sequence descriptors + one-hot polymer label": "SeqDesc+1HotPoly",
    "Prot2vec + polymer chemistry descriptors": "Prot2Vec+PolyChem",
    "Sequence descriptors + polymer chemistry descriptors": "SeqDesc+PolyChem",
    "Prot2vec Transpolymer": "Prot2Vec+TransPoly",
    "Sequence descriptors + Transpolymer": "SeqDesc+TransPoly",
    "ESM2 + one-hot-polymer": "ESM2+1HotPoly",
    "ProtBERT + one-hot-polymer": "ProtBERT+1HotPoly",
    "ESM2 + Polymer Chemistry Descriptors": "ESM2+PolyChem",
    "ProtBERT + Polymer Chemistry Descriptors": "ProtBERT+PolyChem",
    "ESM2+ Transpolymer": "ESM2+TransPoly",
    "ProtBERT + Transpolymer": "ProtBERT+TransPoly",
    "Prot2vec + PolyBERT": "Prot2Vec+PolyBERT",
    "Prot2Vec + PolyBERT": "Prot2Vec+PolyBERT",
    "Sequence descriptors + PolyBERT": "SeqDesc+PolyBERT",
    "ESM2 + PolyBERT": "ESM2+PolyBERT",
    "ProtBERT + PolyBERT": "ProtBERT+PolyBERT",
}

df["Modality_short"] = df["Modality"].map(short_names).fillna(df["Modality"])
df["Plot_ID"] = df["Model"] + "-" + df["Modality_short"]
df["X_Label"] = df["Model"]

# =========================================================
# COLORS
# =========================================================
color_map = {
    "Prot2Vec+1HotPoly": "#4C78A8",
    "SeqDesc+1HotPoly": "#F58518",
    "Prot2Vec+PolyChem": "#54A24B",
    "SeqDesc+PolyChem": "#E45756",
    "Prot2Vec+TransPoly": "#72B7B2",
    "SeqDesc+TransPoly": "#B279A2",
    "ESM2+1HotPoly": "#9D755D",
    "ProtBERT+1HotPoly": "#BAB0AC",
    "ESM2+PolyChem": "#FF9DA6",
    "ProtBERT+PolyChem": "#9C755F",
    "ESM2+TransPoly": "#8E6C8A",
    "ProtBERT+TransPoly": "#66A61E",
    "Prot2Vec+PolyBERT": "#1B9E77",
    "SeqDesc+PolyBERT": "#D95F02",
    "ESM2+PolyBERT": "#7570B3",
    "ProtBERT+PolyBERT": "#7F7F7F",
}

# =========================================================
# PLOTTING FUNCTION
# =========================================================
def make_plot(df_model, model_name, output_fig):

    ordered_labels = df_model["Plot_ID"].drop_duplicates().tolist()

    if len(ordered_labels) == 0:
        print(f"Skipping {model_name}: no labels found.")
        return

    plot_id_to_model = (
        df_model[["Plot_ID", "X_Label"]]
        .drop_duplicates()
        .set_index("Plot_ID")["X_Label"]
        .to_dict()
    )

    label_to_modality_short = (
        df_model[["Plot_ID", "Modality_short"]]
        .drop_duplicates()
        .set_index("Plot_ID")["Modality_short"]
        .to_dict()
    )

    def get_color(plot_id):
        modality_short = label_to_modality_short.get(plot_id, "Other")
        return color_map.get(modality_short, "#7F7F7F")

    x_positions = {}
    section_centers = {}
    divider_positions = []

    current_x = 0.0

    for i, split in enumerate(SPLIT_ORDER):
        x_positions[split] = {}
        start_x = current_x

        for plot_id in ordered_labels:
            x_positions[split][plot_id] = current_x
            current_x += 1.0

        end_x = current_x - 1.0
        section_centers[split] = (start_x + end_x) / 2.0

        if i < len(SPLIT_ORDER) - 1:
            divider_positions.append(current_x - 0.5 + SECTION_GAP / 2.0)

        current_x += SECTION_GAP

    all_xticks = []
    all_xticklabels = []

    for split in SPLIT_ORDER:
        for plot_id in ordered_labels:
            all_xticks.append(x_positions[split][plot_id])
            all_xticklabels.append(plot_id_to_model[plot_id])

    xmin = min(all_xticks)
    xmax = max(all_xticks)

    fig_width = max(22, len(ordered_labels) * len(SPLIT_ORDER) * 0.85)
    fig_height = 27

    fig, axes = plt.subplots(
        4,
        1,
        figsize=(fig_width, fig_height),
        sharex=True,
    )

    panel_letters = ["A", "B", "C", "D"]

    for ax, metric, letter in zip(axes, METRICS, panel_letters):

        for split in SPLIT_ORDER:
            df_split = df_model[df_model["Data Split"] == split].copy()

            for plot_id in ordered_labels:
                row = df_split[df_split["Plot_ID"] == plot_id]

                if row.empty:
                    continue

                mean_val = row[f"{metric}_mean"].values[0]
                sd_val = row[f"{metric}_sd"].values[0]
                xpos = x_positions[split][plot_id]

                if pd.isna(mean_val):
                    continue

                ax.bar(
                    xpos,
                    mean_val,
                    width=BAR_WIDTH,
                    yerr=None if pd.isna(sd_val) else sd_val,
                    capsize=ERROR_CAPSIZE,
                    color=get_color(plot_id),
                    edgecolor="black",
                    linewidth=0.7,
                    zorder=3,
                )

        for d in divider_positions:
            ax.axvline(
                d,
                color="black",
                linestyle="--",
                linewidth=1.0,
                alpha=0.8,
                zorder=2,
            )

        ax.set_title(
            f"({letter}) {metric}",
            loc="left",
            fontsize=SIZE_TITLE,
            fontweight="bold",
        )

        ax.set_ylabel("Score", fontsize=SIZE_YLABEL)
        ax.tick_params(axis="y", labelsize=SIZE_YTICKS)

        ax.set_ylim(YLIMS[metric])
        ax.grid(axis="y", linestyle=":", alpha=0.35, zorder=1)
        ax.set_axisbelow(True)

        ax.spines["top"].set_visible(False)
        ax.spines["right"].set_visible(False)

        ax.set_xlim(xmin - BAR_WIDTH / 2, xmax + BAR_WIDTH / 2)

        y_top = YLIMS[metric][1]

        for split in SPLIT_ORDER:
            ax.text(
                section_centers[split],
                y_top * 1.015,
                split,
                ha="center",
                va="bottom",
                fontsize=SIZE_SPLIT_LABEL,
                fontweight="bold",
            )

    axes[-1].set_xticks(all_xticks)
    axes[-1].set_xticklabels(
        all_xticklabels,
        rotation=ROTATION,
        ha="right",
        fontsize=SIZE_XTICKS,
    )
    axes[-1].tick_params(axis="x", pad=8)

    for ax in axes[:-1]:
        ax.tick_params(axis="x", which="both", labelbottom=False)

    unique_modality_shorts = []
    for plot_id in ordered_labels:
        mod_short = label_to_modality_short.get(plot_id, "Other")
        if mod_short not in unique_modality_shorts:
            unique_modality_shorts.append(mod_short)

    legend_handles = [
        plt.Rectangle(
            (0, 0),
            1,
            1,
            facecolor=color_map.get(mod, "#7F7F7F"),
            edgecolor="black",
        )
        for mod in unique_modality_shorts
    ]

    fig.legend(
        legend_handles,
        unique_modality_shorts,
        loc="upper center",
        bbox_to_anchor=(0.5, 0.965),
        ncol=LEGEND_NCOL,
        frameon=False,
        fontsize=SIZE_LEGEND,
        columnspacing=1.6,
        handletextpad=0.6,
    )

    fig.suptitle(
        f"{model_name}: Performance of Combined Unimodal + Polymer Representations Across Data Splits",
        fontsize=SIZE_SUPTITLE,
        fontweight="bold",
        y=0.995,
    )

    plt.tight_layout(rect=[0, 0.045, 1, 0.87])
    plt.savefig(output_fig, dpi=600, bbox_inches="tight")
    plt.show()

    print(f"Figure saved to: {output_fig}")

# =========================================================
# GENERATE SEPARATE PLOTS
# =========================================================
for model_name, model_keywords in MODEL_GROUPS.items():

    df_model = df[df["Model"].isin(model_keywords)].copy()

    if df_model.empty:
        print(f"Skipping {model_name}: no matching rows found.")
        continue

    output_fig = f"/content/{model_name}_unimodal_plus_polymer_barplot_1x4_clean.png"

    make_plot(
        df_model=df_model,
        model_name=model_name,
        output_fig=output_fig,
    )
